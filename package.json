{
  "name": "orderpilot",
  "description": "OrderPilot: cart builder, order tracker and invoice collector for Amazon.in, Flipkart and JioMart",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "e2e": "wxt build && node tests/e2e/smoke.mjs && node tests/e2e/jiomart-smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "dexie": "^4.4.6",
    "jszip": "^3.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^24.19.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@wxt-dev/module-react": "^1.2.2",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "playwright": "^1.62.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
